[Unit]
Description=AtomNMR user annotation service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/atomnmr/app
ExecStart=/bin/bash %h/atomnmr/app/deploy/server/start-user.sh
Restart=on-failure
RestartSec=30
TimeoutStopSec=60
UMask=0077

[Install]
WantedBy=default.target
