# Store real file at /srv/atomnmr/secrets/atomnmr.env, chmod 600.
ATOMNMR_API_KEY=replace_with_your_group_key
# After first start, set the actual formal job ID to recover after crashes.
ATOMNMR_RESUME_JOB_ID=
PYTHONUNBUFFERED=1
NMRPEAK_LIGHT_IMPORT=1
NO_PROXY=localhost,127.0.0.1,::1,10.8.130.88
no_proxy=localhost,127.0.0.1,::1,10.8.130.88
