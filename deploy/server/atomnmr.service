[Unit]
Description=AtomNMR annotation service
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=atomnmr
Group=atomnmr
WorkingDirectory=/srv/atomnmr/app
EnvironmentFile=/srv/atomnmr/secrets/atomnmr.env
ExecStart=/srv/atomnmr/venv/bin/python -u -m annotation_tool_v3.server_linux --db /srv/atomnmr/data/databases/assignments.sqlite --config /srv/atomnmr/api.json --port 8767
Restart=on-failure
RestartSec=30
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
